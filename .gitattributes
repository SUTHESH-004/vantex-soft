# Normalize all text files to LF in the repo (backend, web, mobile, shared)
* text=auto eol=lf

# Windows scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries — never touch
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
